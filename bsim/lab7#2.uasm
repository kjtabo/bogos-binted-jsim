| r0 -> array lenght
| r1 -> index 1
| r2 -> index 2
| r3 -> thing being checked 1
| r4 -> thing being checked 2
| r5 -> comparison result
| r6 -> tracks if a swap was done or not


.include beta.uasm


START:  LD(r31, INPUT, r0)
        SUBC(r0, 1, r0)
        ADDC(r31, 0, r6)
        ADDC(r31, 4, r1)
        ADDC(r31, 8, r2)

LOOP:   LD(r1, INPUT, r3)
        LD(r2, INPUT, r4)

        CMPLE(r4, r3, r5)
        BT(r5, SWAP)

RETURN: ADDC(r1, 4, r1)
        ADDC(r2, 4, r2)
        SUBC(r0, 1, r0)
        BNE(r0, LOOP)

        BF(r6, DONE)
        BT(r6, START)

SWAP:   ST(r4, INPUT, r1)
        ST(r3, INPUT, r2)
        ADD(r5, r31, r6)
        BT(r5, RETURN)

DONE:   HALT()

|||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||

. = 0x19C

INPUT:
        LONG(7)
        LONG(5)
        LONG(7)
        LONG(8)
        LONG(6)
        LONG(4)
        LONG(9)
        LONG(3)

|||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||

OUTPUT: 