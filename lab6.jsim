.include "8clocks.jsim"
.include "nominal.jsim"
.include "stdcell.jsim"

*******************************************************************************
* 32-bit Adder/Subtractor
*******************************************************************************

.subckt fa a b cin sum cout
    Xab a b ab_sum xor2
    Xsum ab_sum cin sum xor2
    Xnab a b nab nand2
    Xnbc b cin nbc nand2 
    Xnac a cin nac nand2
    Xcarry nab nbc nac cout nand3
.ends

.subckt add32 a[31:0] b[31:0] cin0 sum[31:0] cout[31:30]
    Xbit[0:31] a[0:31] b[0:31] cin0 cout[0:30] sum[0:31] cout[0:31] fa
.ends

* UNUSED
.subckt old_z_ckt a[0:31] out 
  Xnor2_one[0:15] a[0:31] nor2_one_out[0:15] nor2
  Xnand2_one[0:7] nor2_one_out[0:15] nand2_one_out[0:7] nand2
  Xnor2_two[0:3] nand2_one_out[0:7] nor2_two_out[0:3] nor2
  Xnand2_two[0:1] nor2_two_out[0:3] nand2_two_out[0:1] nand2
  xnor2_three nand2_two_out[0:1] out nor2
.ends

* OPTIMIZED ZERO-CHECKER FOR CIRCUIT SIZE
.subckt z_ckt a[0:31] out 
  Xnor2_one[0:7] a[0:31] nor4_one_out[0:7] nor4
  Xnand2_one[0:1] nor4_one_out[0:7] nand4_one_out[0:1] nand4
  xnor2_three nand4_one_out[0:1] out nor2
.ends

.subckt as32 a[31:0] b[31:0] op0 fas[31:0] n v z
  * Former way of deciding to 2's complement `b` or not (64 gates).
  *
  * Xinv[31:0] b[31:0] binv[31:0] inverter
  * Xmux[31:0] op0#32 b[31:0] binv[31:0] bmux[31:0] mux2

  * Changed to only using XOR Gates (32 gates)
  Xinv[31:0] b[31:0] op0#32 bmux[31:0] xor2
  Xadd32 a[31:0] bmux[31:0] op0 fas[31:0] cout[31:30] add32

  .connect fas31 n
  Xv cout[31:30] v xor2
  Xz fas[31:0] z z_ckt
.ends

*******************************************************************************
* 32-bit Comparator 
*******************************************************************************

.subckt cmp32 n v z op[2:1] fcmp[31:0]
  .connect 0 fcmp[31:1]
  Xlt n v lt xor2
  Xeq z op1 eq nand2
  Xlt_out lt op2 lt_out nand2
  Xltz lt_out eq fcmp0 nand2
.ends

*******************************************************************************
* Bitwise Comparison
*******************************************************************************

.subckt bool32 a[31:0] b[31:0] op[3:0] fbool[31:0]
    Xmux[31:0] a[31:0] b[31:0] op0#32 op1#32 op2#32 op3#32 fbool[31:0] mux4
.ends

*******************************************************************************
* 32-bit Shifter
*******************************************************************************

.subckt shift32 a[31:0] b[4:0] op[1:0] fshift[31:0]
    * if shift right, reverse
    Xreverse[31:0] op0#32 a[31:0] a[0:31] aop[31:0] mux2

    * set padding bit
    Xpad op1 0 a31 pad mux2

    * Shift 16
    Xmux_one[31:0] b4#32 aop[31:0] aop[15:0] pad#16 a_one[31:0] mux2

    * Shift 8
    Xmux_two[31:0] b3#32 a_one[31:0] a_one[23:0] pad#8 a_two[31:0] mux2

    * Shift 4
    Xmux_three[31:0] b2#32 a_two[31:0] a_two[27:0] pad#4 a_three[31:0] mux2

    * Shift 2
    Xmux_four[31:0] b1#32 a_three[31:0] a_three[29:0] pad#2 a_four[31:0] mux2

    * Shift 1
    Xmux_five[31:0] b0#32 a_four[31:0] a_four[30:0] pad a_five[31:0] mux2

    * if reversed, reverse back to original
    Xorig[31:0] op0#32 a_five[31:0] a_five[0:31] fshift[31:0] mux2
.ends

*******************************************************************************
* Arithmetic Logic Unit
*******************************************************************************

.subckt alu32 a[31:0] b[31:0] alufn[5:0] f[31:0]
    Xas32 a[31:0] b[31:0] alufn0 fas[31:0] n v z as32
    Xbool32 a[31:0] b[31:0] alufn[3:0] fbool[31:0] bool32 
    Xshift32 a[31:0] b[4:0] alufn[1:0] fshift[31:0] shift32
    Xcmp32 n v z alufn[2:1] fcmp[31:0] cmp32

    Xmux[31:0] alufn4#32 alufn5#32 fas[31:0] fbool[31:0] fshift[31:0] fcmp[31:0] f[31:0] mux4
.ends

*******************************************************************************
* Instantiation
*******************************************************************************

Xalu32 a[31:0] b[31:0] alufn[5:0] f[31:0] alu32

*******************************************************************************
* Test Cases
*******************************************************************************

Wa a[31:0] nrz(0v,5.0v,20ns,0ns,.1ns,.1ns)
+ -1 0x55555555 0xAAAAAAAA 1 -2 -1 -1 0x55555555 0 -1 0x55555555 0
+ -1 0x55555555 0 -1 0x55555555 0 -1 0x55555555 0 1 -1 -1 0x55555555 0xAAAAAAAA -1
+ 0x55555555 0xAAAAAAAA -1 -1 15 0 -1 15 0 -1 15 0

Wb b[31:0] nrz(0v,5.0v,20ns,0ns,.1ns,.1ns)
+ 1 0x55555555 0xAAAAAAAA 1 0 -1 -1 0xAAAAAAAA 0 -1 0xAAAAAAAA 0
+ -1 0xAAAAAAAA 0 -1 0xAAAAAAAA 0 -1 0xAAAAAAAA 0 31 15 0 24 24 31
+ 24 24 31 1 15 -256 1 15 -256 1 15 -256

Wf alufn[5:0] nrz(0v,5.0v,60ns,0ns,.1ns,.1ns)
+ 0 1 24 30 22 26 21 32 33 35 51 53 55

*******************************************************************************
* Plots
*******************************************************************************

.tran 780ns 
.plot a[31:0]
.plot b[31:0]
.plot b(alufn[5:0])
.plot f[31:0]

*******************************************************************************
* Explain how you optimized your alu32 for circuit size.
*******************************************************************************
*
* The zero-checker was optimized more, circuit-size-wise. Instead of limiting
* to using only 2-input NORs and 2-input NANDs, 4-input NORs and NANDs were 
* also used to maximize the number of bits that can be processed with one gate.
* Granted that the zero-checker was slightly slower due to a higher propagation
* delay (0.03ns to 0.07ns and 0.05ns to 0.12ns for NANDs and NORs,
* respectively), it lessened the number of gates used from 31 to 11.
* 
* The logic of the full adder/subtracter was changed. In deciding whether to
* operate on the two’s complement of input b, the NOT and MUXs were replaced
* with a XOR gate instead. An inefficiency was found in that the as32 would
* always produce b and ^b for every bit even though only one of each would be
* used—which is chosen by the MUX. Using a truth table, it can be seen that
* using the NOT and the MUX have the same output as an XOR gate. This was
* inspired and based off of the diagram of a full subtractor circuit that we
* saw back in our PHYS 160: Electronics class. Thus, 32 gates were removed from
* the total count in the ALU.
* 
* The bitwise boolean circuit was pretty straightforward as indicated in the
* specifications. It is implemented to use a 4-input MUX for every pair of
* bits. Since the whole premise is using a “programmable” 4-input MUX to
* replicate logic gates accepting 2 inputs, there is no further way to lessen
* the number of gates in this subcircuit.
* 
* Given how the ALU stores operation codes in binary, it is most intuitive to
* split the bitshifter to the decimal equivalent of each bit of the op. This
* results in having a dedicated 16-bit shifter, 8-bit shifter, and so on. This
* implementation of a 32-bit shifter was optimized by using the same shifting
* logic for both left and right shifts, accounting also for arithmetic
* shifting. Through this method, the circuit was made smaller by about 96 gates
* compared to having dedicated left and right shifts.
*
* Since the ALU just puts all of the previously constructed subcircuits
* together, any optimization in the component parts also becomes an
* optimization for the ALU, and that’s how we optimized the ALU for circuit
* size.
*
*******************************************************************************