.include "8clocks.jsim"
.include "nominal.jsim"
.include "stdcell.jsim"

* ============================= PAGE ONE =============================
* IMPORTANT: the 'n' prefix in variables are used to denote an inverted state
* IMPORTANT: the '_' denotes OR in the fx subckt only


*********************************************************************
* fx circuit with full use of AND and OR gates

.subckt fx_mockup a b c d e f g out
    Xabc a b c abc and3
    Xde d e de and2
    Xfg f g fg and2
    Xabc_de_fg abc de fg out or3
.ends



* Inverting the outputs of NAND and NOR gates used less gates compared to inverting the inputs and then using the complementary gates instead
* This uses a total of 8 gates

.subckt fx a b c d e f g out
    Xnabc a b c nabc nand3
    Xabc nabc abc inverter
    Xnde d e nde nand2
    Xde nde de inverter
    Xnfg f g nfg nand2
    Xfg nfg fg inverter
    Xnabc_de_fg abc de fg nabc_de_fg nor3
    Xabc_de_fg nabc_de_fg out inverter
.ends



* Third and final iteration of the fx circuit, using DeMorgan's Law to reduce OUT=ABC+DE+FG to a NAND-friendly form: OUT=!(!(ABC)!(DE)!(FG))

* Simplification process:
* ABC+DE+FG=!!(ABC+DE+FG)
* = !(!(ABC)!(DE)!(FG))

* This final fx circuit uses a total of 4 gates and is the most efficient solution we have found.

* We have found that this efficiency is largely born from the fact that NAND gates are inherently faster than AND and OR gates, which manifests
* in lower contamination and propagation delays. Another factor that contributes is that the implementation below uses less gates in general.

.subckt fx_three a b c d e f g out
    Xnabc a b c nabc nand3
    Xnde d e nde nand2
    Xnfg f g nfg nand2
    Xabc_de_fg nabc nde nfg out nand3
.ends

*********************************************************************

* fa (full adder) circuit with full use of AND and OR gates
.subckt ha_mockup a b sum carry
    Xsum a b sum xor2
    Xcarry a b carry and2
.ends

.subckt fa_mockup a b carry_in sum carry_out
    Xha_one a b ab_sum carry_one ha_mockup
    Xha_two ab_sum carry_in  sum carry_two ha_mockup
    Xcarry carry_one carry_two carry_out or2
.ends



* Similarly, the same approach was used for the full adder. However, for readability, the half adders used in the full adder were made into its own subckt

* The half adder subckt to be used for the full adder
.subckt ha a b sum carry
    Xsum a b sum xor2
    Xncarry a b nab nand2
    xcarry nab carry inverter
.ends

* This uses a total of 8 gates
.subckt fa a b carry_in sum carry_out
    Xha_one a b ab_sum carry_one ha
    Xha_two ab_sum carry_in sum carry_two ha
    Xncarry carry_one carry_two ncarry nor2
    Xcarry ncarry carry_out inverter
.ends



* Final iteration of the Full Adder.
* We found this to be most efficient due a similar reason to the final iteration of the previous circuti. It makes use of less total gates, and the
* individual gates are generally more efficient.

.subckt fa_three a b carry_in sum carry_out
    Xab a b ab_sum xor2
    Xsum ab_sum carry_in sum xor2
    Xnab a b nab nand2
    Xnbc b carry_in nbc nand2 
    Xnac a carry_in nac nand2
    Xcarry nab nbc nac carry_out nand3
.ends

.subckt xor2_fast a b out
    Xinv_one a not_a inverter
    Xinv_two b not_b inverter
    Xnand_one a not_b a_not_b nand2
    Xnand_two b not_a b_not_a nand2
    Xnand_out a_not_b b_not_a out nand2
.ends 

.subckt fa_cla a b cin sum p g
    Xab a b p xor2_fast
    Xsum p cin sum xor2_fast
    Xnab a b nab nand2
    Xgen nab g inverter
.ends


.subckt 4cla_prop_gen a[3:0] b[3:0] p[3:0] g[3:0] 
    Xp[3:0] a[3:0] b[3:0] p[3:0] xor2_fast
    Xnab[3:0] a[3:0] b[3:0] nab[3:0] nand2
    Xgen[3:0] nab[3:0] g[3:0] inverter
.ends

.subckt prop_gen a b p g0
    Xp a b p xor2_fast
    Xnab a b nab nand2
    Xgen nab g inverter
.ends

.subckt c_one p0 cin g0 c1
    Xnand_one p0 cin in_one nand2
    Xinv_one g0 in_two inverter
    Xout in_one in_two c1 nand2
.ends

.subckt c_two p[1:0] cin g[1:0] c2
    Xnand_one p[1:0] cin in_one nand3
    Xnand_two p[1] g[0] in_two nand2
    Xinv_one g[1] in_three inverter
    Xout in_one in_two in_three c2 nand3
.ends

.subckt c_three p[2:0] cin g[2:0] c3
    Xnand_one p[2:0] cin in_one nand4
    Xnand_two p[2:1] g[0] in_two nand3
    Xnand_three p[2] g[1] in_three nand2
    Xinv_one g[2] in_four inverter
    Xout in_one in_two in_three in_four nand4 
.ends

.subckt c_four p[3:0] cin g[3:0] c4
    Xnor_one_n_one p[3:2] interm_one nand2
    Xnor_one_n_two p[1:0] cin interm_two nand3
    Xnor_one interm_one interm_two in_one nor2
    Xnand_one p[3:1] g[0] interm_three nand4
    Xinv_one interm_three in_two inverter 
    Xnand_two p[3:2] g[1] interm_four nand3
    Xinv_two interm_four in_three inverter
    Xnand_three p[3] g[2] interm_five nand2
    Xinv_three interm_five in_four inverter
    Xinv_four g[3] in_five inverter
    Xout_n_one in_one in_two out_interm_one nor2
    Xout_n_two in_three in_four in_five out_interm_two nor3
    Xout out_interm_one out_interm_two c4 nand2
.ends

.subckt 4cla a[3:0] b[3:0] cin sum[3:0] c[3:0]
    Xp_g a[3:0] b[3:0] p[3:0] g[3:0] 4cla_prop_gen
    Xc_one p[0] cin g[0] c0 c_one
    Xc_two p[1:0] cin g[1:0] c1 c_two
    Xc_three p[2:0] cin g[2:0] c2 c_three
    Xc_four p[3:0] cin g[3:0] c3 c_four
    Xsum c[3:1] cin p[3:0] sum[3:0] xor2_fast
.ends

.subckt 4cla_sum_only p[3:0] g[3:0] cin sum[3:0] c[3:0]
    Xc_one p[0] cin g[0] c0 c_one
    Xc_two p[1:0] cin g[1:0] c1 c_two
    Xc_three p[2:0] cin g[2:0] c2 c_three
    Xc_four p[3:0] cin g[3:0] c3 c_four
    Xsum c[3:1] cin p[3:0] sum[3:0] xor2_fast
.ends

.subckt 4cla_logic_only p[3:0] g[3:0] cin c[3:0]
    Xc_one p[0] cin g[0] c0 c_one
    Xc_two p[1:0] cin g[1:0] c1 c_two
    Xc_three p[2:0] cin g[2:0] c2 c_three
    Xc_four p[3:0] cin g[3:0] c3 c_four group_g
.ends

.subckt group_p p[3:0] group_p
    Xnand_one p[3:0] ngroup_p nand4
    Xinv_one ngroup_p group_p inverter
.ends

.subckt group_g p[3:0] g[3:0] group_g
    Xnand_one p[3:1] g[0] interm_three nand4
    Xinv_one interm_three in_two inverter 
    Xnand_two p[3:2] g[1] interm_four nand3
    Xinv_two interm_four in_three inverter
    Xnand_three p[3] g[2] interm_five nand2
    Xinv_three interm_five in_four inverter
    Xinv_four g[3] in_five inverter
    Xout_n_one in_one in_two out_interm_one nor2
    Xout_n_two in_three in_four in_five out_interm_two nor3
.ends

.subckt group_pg p[3:0] g[3:0] group_p group_g
    Xgroup_p p[3:0] group_p group_p
    Xgroup_g p[3:0] g[3:0] group_g group_g
.ends

.subckt 16cla a[15:0] b[15:0] cin sum[15:0] c[15:14]
    Xp_g[15:0] a[15:0] b[15:0] p[15:0] g[15:0] prop_gen
    Xgroup_pg p[15:0] g[15:0] group_p[3:0] group_g[3:0] group_pg
    X16cla_carry group_p[3:0] group_g[3:0] cin group_c[3:0] 4cla_logic_only
    X4cla p[15:0] g[15:0] cin group_c[2:0] sum[15:0] c[15:0] 4cla_sum_only
.ends



* ============================= PAGE TWO =============================
Xfx clk1 clk2 clk3 clk4 clk5 clk6 clk7 OUT fx
Xfa clk5 clk6 clk7 sum carry fa
Xfx_mock clk1 clk2 clk3 clk4 clk5 clk6 clk7 OUT_MOCK fx_mockup
Xfa_mock clk5 clk6 clk7 sum_mock carry_mock fa_mockup
Xfx_three clk1 clk2 clk3 clk4 clk5 clk6 clk7 OUT_THREE fx_three
Xfa_three clk5 clk6 clk7 sum_three carry_three fa_three

.tran 640ns
.plot clk1
.plot clk2
.plot clk3
.plot clk4
.plot clk5
.plot clk6
.plot clk7
.plot OUT
.plot OUT_MOCK
.plot OUT_THREE
.plot sum
.plot sum_mock
.plot sum_three
.plot carry
.plot carry_mock
.plot carry_three